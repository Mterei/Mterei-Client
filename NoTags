local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local TextChatService = game:GetService("TextChatService")

local Remote = ReplicatedStorage.Remote
local Commands = require(script.CommandFunctions)

local function CreateText(Text : string, Color : string)
	return "<font color='".. Color .."'>".. Text .."</font>"
end

function notagsf(Player : Player, Arguments : {string}, UnfilteredText : string)
	if UnfilteredText ~= "" then
		Remote.CreateSystemMessage:FireAllClients(CreateText(Player.DisplayName .. " [Filter Bypass]" .. ":  ", "#E0A1FF") .. CreateText(UnfilteredText, "#FFFFFF"))
		Remote.CreateBubbleChat:FireAllClients(Player, UnfilteredText)
	end
end

Commands.CreateCommand("notags", notagsf, "Bypasses roblox's chat filter.", "(message)", false)
